#!/usr/bin/env python

import os
import subprocess
from waflib import Logs, Context

def options(opt):
    opt.add_option('--phase', action='store', default='1',
                   help='Build specific phase (1-6)')
    opt.add_option('--debug', action='store_true', default=False,
                   help='Enable debug build')
    opt.add_option('--flash', action='store_true', default=False,
                   help='Flash after building')
    opt.add_option('--monitor', action='store_true', default=False,
                   help='Start monitor after flashing')

def configure(conf):
    phase = int(getattr(conf.options, 'phase', '1'))
    debug = getattr(conf.options, 'debug', False)
    
    Logs.info('=== Configuring Pebble ESP32-C3 Phase %d ===' % phase)
    
    # Generate phase-specific configuration
    generate_phase_config(conf, phase, debug)
    
    # Update ESP-IDF CMakeLists.txt
    update_cmake_lists(conf, phase)
    
    Logs.info('Configuration complete for Phase %d' % phase)

def build(bld):
    phase = int(getattr(bld.options, 'phase', '1'))
    flash = getattr(bld.options, 'flash', False)
    monitor = getattr(bld.options, 'monitor', False)
    
    Logs.info('=== Building Pebble ESP32-C3 Phase %d ===' % phase)
    
    # Use ESP-IDF to build
    cmd = ['idf.py', 'build']
    
    try:
        result = subprocess.call(cmd, cwd=bld.path.abspath())
        Logs.info('Build successful!')
        
        if flash:
            Logs.info('Flashing to device...')
            subprocess.call(['idf.py', 'flash'], cwd=bld.path.abspath())
            
        if monitor:
            Logs.info('Starting monitor...')
            subprocess.call(['idf.py', 'monitor'], cwd=bld.path.abspath())
            
    except subprocess.CalledProcessError as e:
        Logs.error('Build failed: %s' % e)
        return 1

def generate_phase_config(conf, phase, debug):
    """Generate phase-specific header files"""
    
    # Generate version header
    version_content = '''
#pragma once

#define PEBBLE_ESP32_VERSION_MAJOR 0
#define PEBBLE_ESP32_VERSION_MINOR 1
#define PEBBLE_ESP32_VERSION_PATCH 0
#define PEBBLE_ESP32_BUILD_PHASE %d
#define PEBBLE_ESP32_GIT_COMMIT "%s"

#define PEBBLE_ESP32_VERSION_STRING "0.1.0-phase%d"

// Phase-specific defines
#define PHASE_%d 1
%s
''' % (phase, get_git_commit(), phase, phase, 
       '#define DEBUG 1' if debug else '')
    
    version_file = conf.path.make_node('main/version.h')
    version_file.write(version_content)

def update_cmake_lists(conf, phase):
    """Update CMakeLists.txt based on phase"""
    
    sources = ['hello_world_main.c']
    includes = ['.']
    
    # Phase 1: Kernel
    if phase >= 1:
        sources.append('../../../../src/fw/kernel/esp32-c3/kernel_main.c')
        includes.extend(['../../../../src', '../../../../src/fw/kernel/esp32-c3', '../src'])
    
    # Phase 2: HAL Drivers  
    if phase >= 2:
        sources.extend([
            '../src/drivers/display/esp32-c3/display.c',
            '../src/drivers/gpio/esp32-c3/gpio.c'
        ])
    
    cmake_content = '''
idf_component_register(
    SRCS %s
    INCLUDE_DIRS %s
    PRIV_REQUIRES esp_lcd driver spi_flash freertos esp_system
)

target_compile_definitions(${COMPONENT_LIB} PRIVATE
    PHASE_%d=1
    PEBBLE_ESP32_BUILD_PHASE=%d
    ESP32_C3=1
    PLATFORM_ESP32V2=1
)
''' % (' '.join('"%s"' % s for s in sources), ' '.join('"%s"' % i for i in includes), phase, phase)
    
    print('CMake content for phase %d:\n%s' % (phase, cmake_content))
    
    cmake_file = conf.path.make_node('main/CMakeLists.txt')
    cmake_file.write(cmake_content)

def get_git_commit():
    """Get current git commit"""
    try:
        result = subprocess.check_output(['git', 'rev-parse', '--short', 'HEAD'])
        return result.decode('utf-8').strip()
    except:
        return 'unknown'