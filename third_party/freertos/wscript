def configure(conf):
    pass

def build(bld):
    # FreeRTOS vendor code
    use_timers = False
    if bld.env.MICRO_FAMILY == 'STM32F2':
        freertos_port_name = 'ARM_CM3'
    elif bld.env.MICRO_FAMILY == 'STM32F4':
        freertos_port_name = 'ARM_CM4F'
    elif bld.env.MICRO_FAMILY == 'STM32F7':
        freertos_port_name = 'ARM_CM4F' # fix to CM7 when we have it
    elif bld.env.MICRO_FAMILY == 'NRF52840':
        freertos_port_name = 'ARM_CM4F'
        use_timers = True
    elif bld.env.MICRO_FAMILY == 'ESP32_C3':
        # ESP32 uses ESP-IDF's FreeRTOS, not Pebble's ARM FreeRTOS
        # Define freertos_esp32 target to provide ESP-IDF FreeRTOS includes
        # Comprehensive ESP-IDF include paths to resolve all FreeRTOS dependencies
        esp_idf_base = '/Users/jibraniqbal/AndroidStudioProjects/pebble-next/esp-idf'
        pebble_esp_base = '/Users/jibraniqbal/AndroidStudioProjects/pebble-next/pebble-esp'
        
        esp32_freertos_includes = [
            # Core FreeRTOS includes
            f'{esp_idf_base}/components/freertos/FreeRTOS-Kernel/include',
            f'{esp_idf_base}/components/freertos/FreeRTOS-Kernel/portable/riscv/include', 
            f'{esp_idf_base}/components/freertos/esp_additions/include',
            f'{esp_idf_base}/components/freertos/config/include',
            f'{esp_idf_base}/components/freertos/config/include/freertos',
            f'{esp_idf_base}/components/freertos/FreeRTOS-Kernel/portable/riscv/include/freertos',
            
            # ESP32 system components  
            f'{esp_idf_base}/components/esp_system/include',
            f'{esp_idf_base}/components/esp_common/include',
            f'{esp_idf_base}/components/esp_hw_support/include',
            f'{esp_idf_base}/components/esp_timer/include',
            f'{esp_idf_base}/components/esp_event/include',
            f'{esp_idf_base}/components/esp_netif/include',
            f'{esp_idf_base}/components/esp_eth/include',
            f'{esp_idf_base}/components/esp_wifi/include',
            f'{esp_idf_base}/components/esp_phy/esp32c3/include',
            f'{esp_idf_base}/components/esp_phy/include',
            
            # HAL and SOC
            f'{esp_idf_base}/components/hal/esp32c3/include',
            f'{esp_idf_base}/components/hal/include',  
            f'{esp_idf_base}/components/hal/platform_port/include',
            f'{esp_idf_base}/components/soc/esp32c3/include',
            f'{esp_idf_base}/components/soc/include',
            
            # Low-level drivers
            f'{esp_idf_base}/components/driver/include',
            f'{esp_idf_base}/components/driver/esp32c3/include',
            f'{esp_idf_base}/components/gpio/include',
            f'{esp_idf_base}/components/spi_flash/include',
            f'{esp_idf_base}/components/bootloader_support/include',
            f'{esp_idf_base}/components/partition_table/include',
            
            # Utilities and support
            f'{esp_idf_base}/components/log/include',
            f'{esp_idf_base}/components/heap/include',  
            f'{esp_idf_base}/components/newlib/platform_include',
            f'{esp_idf_base}/components/pthread/include',
            f'{esp_idf_base}/components/vfs/include',
            f'{esp_idf_base}/components/nvs_flash/include',
            
            # Build configuration
            f'{pebble_esp_base}/platform/esp32c3/boot/build/config',
            f'{pebble_esp_base}/platform/esp32c3/boot/build/bootloader/config',
            
            # Additional arch-specific config paths
            f'{esp_idf_base}/components/freertos/config/riscv/include',
            f'{esp_idf_base}/components/freertos/config/esp32c3/include',
        ]
        
        bld(export_includes=esp32_freertos_includes,
            name='freertos_esp32')
        
        # Also create esp32_system target if it doesn't exist
        bld(export_includes=esp32_freertos_includes,
            name='esp32_system')
        return
    else:
        bld.fatal('Unrecognized env.MICRO_FAMILY value %r' %
                  bld.env.MICRO_FAMILY)

    freertos_includes = [
        '.',
        'FreeRTOS-Kernel/FreeRTOS/Source/include',
        f'FreeRTOS-Kernel/FreeRTOS/Source/portable/GCC/{freertos_port_name}'
    ]

    freertos_source_paths = [
        'FreeRTOS-Kernel/FreeRTOS/Source',
        f'FreeRTOS-Kernel/FreeRTOS/Source/portable/GCC/{freertos_port_name}'
    ]
    freertos_sources = sum([bld.path.ant_glob(d + '/*.c')
                           for d in freertos_source_paths], [])

    freertos_defines = [f'FREERTOS_USE_TIMERS={int(use_timers)}']

    bld(export_includes=freertos_includes,
        export_defines=freertos_defines,
        name='freertos_includes')

    bld.stlib(source=freertos_sources,
              target='freertos',
              use=['pblibc',
                   'fw_includes',
                   'freertos_includes'],
              export_defines='GCC_{}'.format(freertos_port_name))

